# Paths only: generate actual local credentials with `make dev-secrets`.
# Never place DSNs, passwords, private keys, bootstrap codes, or tokens here.
SECRET_DIR=./.dev/secrets
CERT_DIR=./.dev/certs

# Loopback-only local endpoints.
EDGE_PORT=8080
MAILPIT_UI_PORT=8025

# Required only because the local Edge endpoint is plain HTTP.
EDGE_INSECURE_REFRESH_COOKIE=true

# Optional hardening. Forwarded client IP headers are ignored unless every
# direct peer address is covered by one of these comma-separated CIDRs.
EDGE_TRUSTED_PROXY_CIDRS=
IDENTITY_BCRYPT_CONCURRENCY=4

# Retrieval/TEI tuning for local runs.
# Increased default to reduce startup OOM/timeout issues on warmup for large models.
M5_TEI_MEMORY_LIMIT=16g
M5_TEI_CPU_LIMIT=4.0
M5_TEI_MAX_CLIENT_BATCH_SIZE=16
M5_TEI_TMPFS_SIZE=256m
M5_TEI_HTTP_PORT=8082
RETRIEVAL_TEI_LOG_RAW_RESPONSE=false
RETRIEVAL_TEI_LOG_RAW_RESPONSE_MAX_BYTES=4096
INGESTION_DEBUG_DUMP_PDFTEXT_DIR=
INGESTION_PARSER_SANDBOX_MEMORY_BYTES=1610612736
QDRANT_HTTP_PORT=6333
RETRIEVAL_SERVERLESS_INVOCATION_TIMEOUT=10m
M5_COMPOSE_WAIT_MODE=manual
M5_COMPOSE_WAIT_TIMEOUT=300
M5_STRICT_COMPOSE_WAIT=false
M5_BACKEND_READINESS_TIMEOUT=900

# Numeric distroless identity used after service secrets are loaded.
RUN_AS_UID=65532
RUN_AS_GID=65532
# Milestone 6 real-provider configuration. Keep the API key in the referenced
# owner-readable file; never place it in this environment file.
ANSWER_LLM_BASE_URL=
ANSWER_LLM_MODEL=
ANSWER_LLM_API_KEY_PATH=.dev/secrets/answer_llm_api_key
# Leave requests-per-minute empty for the model-aware default; set 0 explicitly
# to disable throttling. Provider byte limits bound the serialized HTTP exchange.
ANSWER_PROVIDER_REQUESTS_PER_MINUTE=
ANSWER_PROVIDER_MAX_REQUEST_BYTES=131072
ANSWER_PROVIDER_MAX_RESPONSE_BYTES=131072
ANSWER_PROVIDER_MAX_CANDIDATE_BYTES=32768
# Optional final-answer cache. Leave capacity and TTL at zero to disable it.
# Cache reuse still performs live Retrieval first and requires matching auth,
# filters, corpus snapshot, selected evidence, Retrieval profile, generator
# profile, answer intent, lexical topic compatibility, and query embedding
# similarity.
ANSWER_CACHE_CAPACITY=0
ANSWER_CACHE_TTL=0s
ANSWER_CACHE_MINIMUM_COSINE=0.95
ANSWER_CACHE_SEMANTIC_ONLY_MINIMUM_COSINE=0.985
ANSWER_CACHE_MINIMUM_LEXICAL_TOPIC_OVERLAP=0.8
EDGE_CATALOG_PREVIEW_DEADLINE=6s
CATALOG_PREVIEW_TIMEOUT=5s

# Optional retrieval summary provider. Leave unset for local indexing and
# retrieval investigations unless you explicitly want retrieval-side summaries.
RETRIEVAL_SUMMARY_LLM_BASE_URL=
RETRIEVAL_SUMMARY_LLM_MODEL=
RETRIEVAL_SUMMARY_LLM_MAX_OUTPUT_TOKENS=64
RETRIEVAL_SUMMARY_LLM_MAX_CALLS=100
RETRIEVAL_SUMMARY_LLM_TIMEOUT=90s
RETRIEVAL_RECIPROCAL_RANK_FUSION_K=60
RETRIEVAL_QDRANT_DOCUMENT_EVIDENCE_LIMIT=3
# json_or_plain accepts a safe plain-text summary when the provider ignores JSON
# mode. Set strict_json to require the structured relevance contract.
RETRIEVAL_SUMMARY_LLM_OUTPUT_MODE=json_or_plain
